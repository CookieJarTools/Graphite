#!/usr/bin/env bash
# The Control Panel's few changes that need the administrator: run as root through pkexec
# (org.graphite.admin.policy asks for an administrator's password, once every few minutes).
# Installed root-owned in /usr/local/lib/graphite by install.sh, so nothing a normal program
# can edit ever runs as root. It takes only these verbs, and checks every argument:
#
#   firewall on|off                      the firewall (ufw): nothing comes in uninvited
#   user-add NAME FULL_NAME yes|no       a new person (an administrator or not); password on stdin
#   user-remove NAME                     a person and their files
#   user-password NAME                   a new password, on stdin
#   user-fullname NAME FULL_NAME         the name shown for them
#   user-admin NAME yes|no               whether they are an administrator
#   pin NAME                             their sign-in PIN (4 digits), on stdin; empty removes it
#   hint NAME                            their password hint for the login screen, on stdin
#   fix-home NAME                        their home folder all theirs again
#   flatpak-update                       everyone's Flathub apps updated (with the driver's parts)
#   format PARTITION FS LABEL            a new, empty file system on one partition
#   erase DISK FS LABEL                  a whole drive emptied, with one partition (never the
#                                        drive the system runs from)
#   package-install NAME...              apps from Arch Linux's own repositories
#   package-remove NAME                  one of them uninstalled (never the system's own parts)
#   flatpak-remove APP_ID                an app from Flathub installed for everyone
#   clean                                old package downloads and logs
#   dynamic-disks                        Windows dynamic disks readable: their volumes opened,
#                                        now and at every start
#   dynamic-to-basic DISK                a Windows dynamic disk with one volume made a basic disk,
#                                        its files kept
#   ntfs-repair PARTITION                a Windows partition Windows left marked in use, cleared
#   install                              Graphite's system parts again, from /opt/graphite-desk
set -euo pipefail

name_ok() { [[ "$1" =~ ^[a-z][a-z0-9_-]{0,30}$ ]] || { echo "Not a valid name." >&2; exit 2; }; }
person_ok() {
    name_ok "$1"
    local uid
    uid="$(id -u "$1" 2>/dev/null)" || { echo "No such person." >&2; exit 2; }
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || { echo "That account belongs to the system." >&2; exit 2; }
}
read_secret() { IFS= read -r secret || true; [ -n "$secret" ] || { echo "Nothing was given." >&2; exit 2; }; }
# Never the drive the system runs from (/, /boot or /home on it, through encryption too).
not_system_drive() {
    local mount source source_disk
    for mount in / /boot /home; do
        source="$(findmnt -no SOURCE "$mount" 2>/dev/null)" || continue
        source_disk="/dev/$(lsblk -no PKNAME "$(readlink -f "$source")" 2>/dev/null | tail -1)"
        while [ "$(lsblk -dno TYPE "$source_disk" 2>/dev/null)" != disk ] && [ "$source_disk" != /dev/ ]; do
            source_disk="/dev/$(lsblk -no PKNAME "$source_disk" 2>/dev/null | tail -1)"
        done
        [ "$source_disk" = "$1" ] && { echo "That's the drive Graphite Desk runs from." >&2; exit 2; }
    done
    return 0
}
# Tools from Arch's own packages, installed the first time they're needed.
needs() {
    local tool="$1" package="$2"
    command -v "$tool" >/dev/null || pacman -S --needed --noconfirm "$package" >/dev/null 2>&1 || pacman -Syu --needed --noconfirm "$package" >/dev/null
}

verb="${1:-}"
shift || true
case "$verb" in
    firewall)
        case "${1:-}" in
            on) ufw default deny incoming >/dev/null; ufw default allow outgoing >/dev/null; ufw --force enable ;;
            off) ufw disable ;;
            *) exit 2 ;;
        esac
        ;;
    user-add)
        person="${1:-}"; full="${2:-}"; admin="${3:-no}"
        name_ok "$person"
        [[ "$full" =~ ^[^:,]{1,60}$ ]] || { echo "Not a valid full name." >&2; exit 2; }
        read_secret
        groups="video,input"
        [ "$admin" = yes ] && groups="wheel,$groups"
        useradd -m -G "$groups" -c "$full" -s /bin/bash "$person"
        printf '%s:%s\n' "$person" "$secret" | chpasswd
        # Their desktop: the same Graphite Desk, from the shared copy.
        home="/home/$person"
        mkdir -p "$home/.config/quickshell" "$home/.config/hypr" "$home/.config/graphite"
        ln -sfn /opt/graphite-desk/linux/quickshell "$home/.config/quickshell/graphite"
        ln -sfn /opt/graphite-desk/linux/hypr/hyprland.lua "$home/.config/hypr/hyprland.lua"
        chown -R "$person:$person" "$home"
        ;;
    user-remove)
        person_ok "${1:-}"
        [ "$1" != "$(id -nu "${PKEXEC_UID:-0}" 2>/dev/null)" ] || { echo "You can't remove yourself." >&2; exit 2; }
        loginctl terminate-user "$1" 2>/dev/null || true
        userdel -r "$1" 2>/dev/null || userdel "$1"
        rm -f "/var/lib/graphite/hints/$1"
        rm -rf "/var/lib/graphite/pins/$1"
        ;;
    user-password)
        person_ok "${1:-}"
        read_secret
        printf '%s:%s\n' "$1" "$secret" | chpasswd
        ;;
    user-fullname)
        person_ok "${1:-}"
        [[ "${2:-}" =~ ^[^:,]{1,60}$ ]] || { echo "Not a valid full name." >&2; exit 2; }
        usermod -c "$2" "$1"
        ;;
    user-admin)
        person_ok "${1:-}"
        if [ "${2:-}" = yes ]; then gpasswd -a "$1" wheel >/dev/null; else gpasswd -d "$1" wheel >/dev/null; fi
        ;;
    pin)
        # A PIN for signing in (4 digits, or up to 8) on stdin, kept as a salted hash that only
        # the person (for the lock screen) and root (the login screen) can read; empty removes it.
        person_ok "${1:-}"
        IFS= read -r pin || true
        install -d -m 755 /var/lib/graphite /var/lib/graphite/pins
        dir="/var/lib/graphite/pins/$1"
        rm -rf "$dir" "/run/graphite-pins/$1"
        if [ -n "$pin" ]; then
            [[ "$pin" =~ ^[0-9]{4,8}$ ]] || { echo "A PIN is 4 to 8 digits." >&2; exit 2; }
            install -d -m 700 -o "$1" -g "$1" "$dir"
            openssl passwd -6 -stdin <<<"$pin" > "$dir/hash"
            chown "$1:$1" "$dir/hash"
            chmod 600 "$dir/hash"
        fi
        ;;
    hint)
        person_ok "${1:-}"
        IFS= read -r hint || true
        mkdir -p /var/lib/graphite/hints
        chmod 755 /var/lib/graphite /var/lib/graphite/hints
        if [ -n "$hint" ]; then
            printf '%s\n' "${hint:0:80}" > "/var/lib/graphite/hints/$1"
            chmod 644 "/var/lib/graphite/hints/$1"
        else
            rm -f "/var/lib/graphite/hints/$1"
        fi
        ;;
    fix-home)
        # Their home folder all theirs again (something run as the system left folders in it).
        person_ok "${1:-}"
        chown -R "$1:$1" "/home/$1"
        ;;
    flatpak-update)
        # Everyone's apps from Flathub brought up to date, with the parts for this graphics driver.
        flatpak update --system -y --noninteractive >/dev/null 2>&1 || true
        ;;
    format | erase)
        # format PARTITION FS LABEL: a new, empty file system on one partition.
        # erase DISK FS LABEL: everything on a drive gone, with one partition across it.
        # Never the drive the system runs from. FS: exfat (Windows and Macs read it too), ntfs,
        # fat32 or ext4 (Linux only; made the person's own).
        device="${1:-}"; fs="${2:-}"; label="${3:-}"
        [[ "$device" =~ ^/dev/[a-z0-9]+$ ]] && [ -b "$device" ] || { echo "Not a drive." >&2; exit 2; }
        [[ "$fs" =~ ^(exfat|ntfs|fat32|ext4)$ ]] || { echo "Not a file system this can make." >&2; exit 2; }
        [[ "$label" =~ ^[A-Za-z0-9\ _-]{0,11}$ ]] || { echo "Names can have letters, numbers and spaces, up to 11." >&2; exit 2; }
        disk="$device"
        [ "$verb" = format ] && disk="/dev/$(lsblk -no PKNAME "$device" | head -1)"
        [ "$(lsblk -dno TYPE "$disk" 2>/dev/null)" = disk ] || { echo "Not a drive." >&2; exit 2; }
        not_system_drive "$disk"
        [ "$verb" = erase ] && needs sgdisk gptfdisk
        [ "$fs" = ntfs ] && needs mkfs.ntfs ntfsprogs
        # Nothing on it in use.
        for part in $(lsblk -lnpo NAME "$disk"); do
            umount -q "$part" 2>/dev/null || true
        done
        owner="${PKEXEC_UID:-0}"
        if [ "$verb" = erase ]; then
            wipefs -aq "$disk"
            sgdisk --zap-all "$disk" >/dev/null
            code=0700; [ "$fs" = ext4 ] && code=8300
            sgdisk -n 1:0:0 -t "1:$code" "$disk" >/dev/null
            partprobe "$disk"; udevadm settle
            device="$(lsblk -lnpo NAME,TYPE "$disk" | awk '$2=="part" {print $1; exit}')"
        fi
        wipefs -aq "$device"
        case "$fs" in
            exfat) mkfs.exfat -L "${label:-Drive}" "$device" >/dev/null ;;
            ntfs) mkfs.ntfs -Q -F -L "${label:-Drive}" "$device" >/dev/null ;;
            fat32) mkfs.fat -F 32 -n "${label:-DRIVE}" "$device" >/dev/null ;;
            ext4) mkfs.ext4 -q -F -L "${label:-Drive}" -E "root_owner=$owner:$(id -g "$owner" 2>/dev/null || echo 0)" "$device" ;;
        esac
        ;;
    package-install)
        # Apps from Arch Linux's own repositories only (never a file from somewhere else).
        [ $# -ge 1 ] || exit 2
        for package in "$@"; do
            [[ "$package" =~ ^[a-z0-9@._+-]{1,80}$ ]] || { echo "Not a package name." >&2; exit 2; }
            pacman -Si "$package" >/dev/null 2>&1 || { echo "$package isn't in Arch Linux's repositories." >&2; exit 2; }
        done
        # When the package list is old the download fails; then everything is brought up to date
        # with it (Arch never mixes a fresh package into an old system).
        pacman -S --needed --noconfirm "$@" >/dev/null 2>&1 || pacman -Syu --needed --noconfirm "$@" >/dev/null
        ;;
    package-remove)
        package="${1:-}"
        [[ "$package" =~ ^[a-z0-9@._+-]{1,80}$ ]] || { echo "Not a package name." >&2; exit 2; }
        case "$package" in
            base | linux* | systemd* | pacman | sudo | polkit | greetd* | hyprland | quickshell* | kitty | nautilus | \
            xdg-desktop-portal* | networkmanager | bluez* | pipewire* | wireplumber | mesa | nvidia* | flatpak | ufw | plymouth)
                echo "$package is part of the system and can't be removed." >&2; exit 2 ;;
        esac
        pacman -Q "$package" >/dev/null 2>&1 || exit 0
        pacman -Rns --noconfirm "$package" >/dev/null
        ;;
    flatpak-remove)
        [[ "${1:-}" =~ ^[A-Za-z0-9_.-]{3,120}$ ]] || { echo "Not an app id." >&2; exit 2; }
        flatpak uninstall --system -y --noninteractive "$1" >/dev/null
        ;;
    clean)
        paccache -rk1 >/dev/null 2>&1 || true
        paccache -ruk0 >/dev/null 2>&1 || true
        journalctl --vacuum-size=200M >/dev/null 2>&1 || true
        flatpak uninstall --system --unused -y --noninteractive >/dev/null 2>&1 || true
        ;;
    dynamic-disks)
        # Windows' own layout for some drives, which Linux reads with Arch's ldmtool (libldm):
        # each volume becomes a device of its own, then connects like any partition.
        needs ldmtool libldm
        systemctl enable graphite-dynamic-disks.service >/dev/null 2>&1 || true
        ldmtool create all >/dev/null
        ;;
    dynamic-to-basic)
        # A Windows dynamic disk made a basic one, every file kept: when it holds one volume in
        # one piece, only the partition table changes. Windows' two dynamic-disk partitions go,
        # and one basic data partition takes their place exactly where the volume lies. The
        # table as it was is kept in /var/lib/graphite/partition-tables, and put back when the
        # new partition doesn't read as the NTFS volume it should.
        disk="${1:-}"
        [[ "$disk" =~ ^/dev/[a-z0-9]+$ ]] && [ "$(lsblk -dno TYPE "$disk" 2>/dev/null)" = disk ] || { echo "Not a drive." >&2; exit 2; }
        not_system_drive "$disk"
        ldm_data=af9b60a0-1431-4f62-bc68-3311714a69ad
        ldm_metadata=5808c8aa-7e8f-42e0-85d2-e1e90434cfb3
        lsblk -nro PARTTYPE "$disk" | grep -qix "$ldm_data" || { echo "That isn't a Windows dynamic disk." >&2; exit 2; }
        # Places below are counted in 512-byte sectors, as the drive's own are.
        [ "$(cat "/sys/class/block/$(basename "$disk")/queue/logical_block_size")" = 512 ] || { echo "This drive's sectors aren't the usual size; nothing was changed." >&2; exit 2; }
        needs ldmtool libldm
        needs sgdisk gptfdisk
        ldmtool create all >/dev/null 2>&1 || true
        udevadm settle

        # Its one volume, in one piece, on this drive.
        mapfile -t volumes < <(lsblk -nro NAME,TYPE "$disk" | awk '$2 == "ldm" || $2 == "dm" { print $1 }' | sort -u)
        [ "${#volumes[@]}" = 1 ] || { echo "This drive holds ${#volumes[@]} volumes; only a drive with one can be converted here." >&2; exit 2; }
        volume="${volumes[0]}"
        findmnt -rn -S "/dev/mapper/$volume" >/dev/null && { echo "Disconnect the drive first." >&2; exit 2; }
        table="$(dmsetup table "$volume")"
        [ "$(wc -l <<<"$table")" = 1 ] && [ "$(awk '{ print $3 }' <<<"$table")" = linear ] ||
            { echo "The volume is in pieces (spanned, striped or mirrored), which can't be converted here." >&2; exit 2; }
        read -r _ length _ under offset <<<"$table"
        # Where it starts on the drive: it lies on the drive itself or on one of its partitions.
        under_name="$(lsblk -nro NAME,MAJ:MIN "$disk" | awk -v device="$under" '$2 == device { print $1; exit }')"
        [ -n "$under_name" ] || { echo "The volume isn't on this drive alone." >&2; exit 2; }
        start="$offset"
        [ "/dev/$under_name" != "$disk" ] && start=$(( offset + $(cat "/sys/class/block/$under_name/start") ))
        end=$(( start + length - 1 ))
        # Inside Windows' dynamic data partition, where volumes live.
        data_name="$(lsblk -nro NAME,PARTTYPE "$disk" | awk -v type="$ldm_data" 'tolower($2) == type { print $1; exit }')"
        data_start="$(cat "/sys/class/block/$data_name/start")"
        data_end=$(( data_start + $(cat "/sys/class/block/$data_name/size") - 1 ))
        [ "$start" -ge "$data_start" ] && [ "$end" -le "$data_end" ] ||
            { echo "The volume isn't where Windows keeps them on this drive; nothing was changed." >&2; exit 2; }
        [ "$(dd if="$disk" bs=512 skip="$start" count=1 status=none | dd bs=1 skip=3 count=4 status=none)" = NTFS ] ||
            { echo "The volume doesn't start with Windows' NTFS where it should; nothing was changed." >&2; exit 2; }

        install -d -m 700 /var/lib/graphite/partition-tables
        backup="/var/lib/graphite/partition-tables/$(basename "$disk")-$(date +%Y%m%d-%H%M%S).gpt"
        sgdisk --backup="$backup" "$disk" >/dev/null
        dmsetup remove "$volume"
        number="$(lsblk -nro PARTN,PARTTYPE "$disk" | awk -v type="$ldm_data" 'tolower($2) == type { print $1; exit }')"
        changes=(--set-alignment=1)
        while read -r partition type; do
            [ "${type,,}" = "$ldm_data" ] || [ "${type,,}" = "$ldm_metadata" ] && changes+=(--delete="$partition")
        done < <(lsblk -nro PARTN,PARTTYPE "$disk" | awk 'NF == 2')
        changes+=(--new="$number:$start:$end" --typecode="$number:0700" --change-name="$number:Basic data partition")
        sgdisk "${changes[@]}" "$disk" >/dev/null
        partprobe "$disk" 2>/dev/null || true
        udevadm settle
        converted="$(lsblk -nrpo NAME,PARTN "$disk" | awk -v number="$number" '$2 == number { print $1; exit }')"
        if [ -z "$converted" ] || [ "$(blkid -p -o value -s TYPE "$converted" 2>/dev/null)" != ntfs ]; then
            sgdisk --load-backup="$backup" "$disk" >/dev/null
            partprobe "$disk" 2>/dev/null || true
            ldmtool create all >/dev/null 2>&1 || true
            echo "The new partition didn't read as expected, so the drive was put back as it was." >&2
            exit 1
        fi
        ;;
    ntfs-repair)
        # A Windows (NTFS) partition that Windows left marked in use (Fast Startup, or a shutdown
        # that didn't finish), which Linux won't change: the mark cleared by ntfs-3g's ntfsfix,
        # which also empties the journal and has Windows check the drive when it next starts.
        part="${1:-}"
        [[ "$part" =~ ^/dev/[a-z0-9]+$ ]] && [ "$(lsblk -dno TYPE "$part" 2>/dev/null)" = part ] || { echo "Not a partition." >&2; exit 2; }
        [ "$(lsblk -dno FSTYPE "$part")" = ntfs ] || { echo "That isn't a Windows (NTFS) partition." >&2; exit 2; }
        not_system_drive "/dev/$(lsblk -no PKNAME "$part" | head -1)"
        findmnt -rn -S "$part" >/dev/null && { echo "Disconnect it first." >&2; exit 2; }
        needs ntfsfix ntfsprogs
        ntfsfix -d "$part" >/dev/null
        ;;
    install)
        bash /opt/graphite-desk/linux/system/install.sh
        ;;
    *)
        echo "Unknown request." >&2
        exit 2
        ;;
esac
