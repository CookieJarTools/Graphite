[Unit]
Description=Graphite automatic update (when turned on in the Control Panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-inhibit --what=sleep:shutdown --who="Graphite" --why="Installing updates" /usr/local/lib/graphite/system-update --auto
Nice=19
IOSchedulingClass=idle
