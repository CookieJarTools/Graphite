# Graphite Desk: Windows dynamic disks' volumes opened at start-up, so they connect like any
# partition (the Control Panel's Drives page turns this on: graphite-admin dynamic-disks).
[Unit]
Description=Open Windows dynamic disks
ConditionPathExists=/usr/bin/ldmtool
After=systemd-udevd.service
Before=udisks2.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/udevadm settle
ExecStart=/usr/bin/ldmtool create all

[Install]
WantedBy=multi-user.target
