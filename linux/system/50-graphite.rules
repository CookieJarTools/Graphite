// Graphite Desk: what an administrator sitting at the computer may do without typing their
// password, as on Windows: install updates, set the time zone, the clock, the computer's name
// and the keyboard, and connect the computer's own drives.
polkit.addRule(function (action, subject) {
    if (!subject.local || !subject.active || !subject.isInGroup("wheel")) return polkit.Result.NOT_HANDLED;
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "graphite-update.service" &&
        action.lookup("verb") == "start") {
        return polkit.Result.YES;
    }
    var free = [
        "org.freedesktop.timedate1.set-timezone",
        "org.freedesktop.timedate1.set-ntp",
        "org.freedesktop.hostname1.set-hostname",
        "org.freedesktop.hostname1.set-static-hostname",
        "org.freedesktop.locale1.set-keyboard",
        "org.freedesktop.udisks2.filesystem-mount-system"
    ];
    if (free.indexOf(action.id) >= 0) return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
